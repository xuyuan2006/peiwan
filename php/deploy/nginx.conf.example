#     listen 443 ssl http2;
#     server_name peiwang.example.com;
#     root /www/wwwroot/peiwang/public;
#     index index.php index.html;
#
#     ssl_certificate     /www/server/panel/vhost/cert/peiwang/fullchain.pem;
#     ssl_certificate_key /www/server/panel/vhost/cert/peiwang/privkey.pem;
#     ssl_protocols       TLSv1.2 TLSv1.3;
#     ssl_ciphers         ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
#     ssl_prefer_server_ciphers on;
#
#     add_header Strict-Transport-Security "max-age=31536000" always;
#
#     # ……其余 location 规则与上面的 80 端口块完全一致……
# }
#
# server {
#     listen 80;
#     server_name peiwang.example.com;
#     return 301 https://$host$request_uri;
# }
