<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标 · 前景层（自适应图标）

  图形：头戴式耳机 —— 陪玩的核心场景就是连麦开黑，比通用游戏手柄更贴题。

  坐标说明：自适应图标画布是 108×108，但只有中间的 72×72（即 18~90）是安全区，
  超出部分会被圆形/方形遮罩切掉。本图形实际占用 x 22~86、y 42~82，完全落在安全区内。

  这个 drawable 同时被用作 <monochrome>（主题图标），所以必须是纯色剪影，不能带渐变。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 头梁：从左耳罩到右耳罩的半圆（弦长 40 = 2×半径 20，正好是半圆） -->
    <path
        android:pathData="M34,62 A20,20 0 0 1 74,62"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- 左耳罩 -->
    <path
        android:pathData="M26,58 h12 a4,4 0 0 1 4,4 v16 a4,4 0 0 1 -4,4 h-12 a4,4 0 0 1 -4,-4 v-16 a4,4 0 0 1 4,-4 z"
        android:fillColor="#FFFFFFFF" />

    <!-- 右耳罩 -->
    <path
        android:pathData="M70,58 h12 a4,4 0 0 1 4,4 v16 a4,4 0 0 1 -4,4 h-12 a4,4 0 0 1 -4,-4 v-16 a4,4 0 0 1 4,-4 z"
        android:fillColor="#FFFFFFFF" />
</vector>
